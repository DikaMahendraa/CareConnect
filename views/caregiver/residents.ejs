<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Residents | CareConnect</title>
    <link rel="stylesheet" href="/css/residents.css">
</head>
<body>

<%
    const name = typeof caregiverName !== "undefined" && caregiverName
        ? caregiverName
        : "Caregiver";

    const residentList = typeof residents !== "undefined" && Array.isArray(residents)
        ? residents
        : [];

    function getStatusClass(status) {
        if (status === "At Home") return "home";
        if (status === "Outside") return "outside";
        return "inactive";
    }

    function getStatusLabel(status) {
        if (status === "At Home") return "At Home";
        if (status === "Outside") return "Outside";
        return "No Movement";
    }
%>

<div class="cc-layout">

    <!-- SIDEBAR -->
    <aside class="cc-sidebar">

        <div class="cc-brand">
            <div class="cc-brand-icon">C</div>
            <div>
                <h2>CareConnect</h2>
                <span>Caregiver Portal</span>
            </div>
        </div>

        <div class="cc-sidebar-label">WORKSPACE</div>

        <nav class="cc-navigation">

            <a href="/caregiver/dashboard" class="cc-nav-link">
                <span class="cc-nav-icon">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                    </svg>
                </span>
                <span>Dashboard</span>
            </a>

            <a href="/caregiver/residents" class="cc-nav-link active">
                <span class="cc-nav-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="9" cy="8" r="3"/>
                        <path d="M3 20v-1a6 6 0 0 1 12 0v1"/>
                        <path d="M16 5a3 3 0 0 1 0 6"/>
                        <path d="M18 14a5 5 0 0 1 3 5v1"/>
                    </svg>
                </span>
                <span>Daftar Lansia</span>
            </a>

            <a href="/caregiver/monitoring" class="cc-nav-link">
                <span class="cc-nav-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 12h4l3-8 4 16 3-8h4"/>
                    </svg>
                </span>
                <span>Monitoring</span>
            </a>

            <a href="/caregiver/alerts" class="cc-nav-link">
                <span class="cc-nav-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/>
                        <path d="M10 21h4"/>
                    </svg>
                </span>
                <span>Alert Center</span>
            </a>

        </nav>

        <div class="cc-sidebar-bottom">
            <form action="/logout" method="POST">
                <button type="submit" class="cc-logout">
                    <svg viewBox="0 0 24 24">
                        <path d="M10 17l5-5-5-5"/>
                        <path d="M15 12H3"/>
                        <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/>
                    </svg>
                    <span>Log out</span>
                </button>
            </form>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="cc-main">

        <!-- TOPBAR -->
        <header class="cc-topbar">

            <div class="cc-breadcrumb">
                Caregiver <span>/</span> <strong>Residents</strong>
            </div>

            <div class="cc-topbar-right">

                <div class="cc-workspace-status">
                    <span class="cc-status-dot"></span>
                    Caregiver Workspace
                </div>

                <div class="cc-topbar-profile">
                    <div class="cc-topbar-avatar">
                        <%= name.charAt(0).toUpperCase() %>
                    </div>

                    <div class="cc-topbar-profile-info">
                        <strong><%= name %></strong>
                        <span>Caregiver</span>
                    </div>
                </div>

            </div>

        </header>

        <!-- PAGE CONTENT -->
        <section class="cc-content">

            <!-- PAGE HEADING -->
            <div class="cc-page-heading">
                <div>
                    <span class="cc-eyebrow">RESIDENT MANAGEMENT</span>
                    <h1>Daftar Lansia</h1>
                    <p>Informasi lansia yang menjadi tanggung jawab Anda.</p>
                </div>

                <div class="cc-heading-label">
                    <span>CARECONNECT</span>
                    <strong>Resident Directory</strong>
                </div>
            </div>

            <!-- RESIDENT SUMMARY -->
            <section class="cc-resident-summary">

                <div class="cc-resident-summary-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="9" cy="8" r="3"/>
                        <path d="M3 20v-1a6 6 0 0 1 12 0v1"/>
                        <path d="M16 5a3 3 0 0 1 0 6"/>
                    </svg>
                </div>

                <div>
                    <span>Total Lansia yang Didampingi</span>
                    <strong><%= residentList.length %></strong>
                </div>

            </section>

            <!-- RESIDENT SECTION -->
            <section class="cc-panel">

                <div class="cc-panel-header">
                    <div>
                        <h2>Lansia yang Didampingi</h2>
                        <p>Pantau informasi dan status aktivitas setiap lansia.</p>
                    </div>

                    <span class="cc-total-label">
                        <%= residentList.length %> Residents
                    </span>
                </div>

                <% if (residentList.length > 0) { %>

                    <div class="cc-resident-grid">

                        <% residentList.forEach(resident => { %>

                            <article class="cc-resident-card">

                                <div class="cc-resident-card-top">

                                    <div class="cc-resident-photo">

                                        <% if (resident.foto) { %>
                                            <img
                                                src="<%= resident.foto %>"
                                                alt="Foto <%= resident.nama %>"
                                            >
                                        <% } else { %>
                                            <div class="cc-resident-avatar">
                                                <%= resident.nama
                                                    ? resident.nama.charAt(0).toUpperCase()
                                                    : "L" %>
                                            </div>
                                        <% } %>

                                    </div>

                                    <span class="cc-resident-status <%= getStatusClass(resident.status_aktivitas) %>">
                                        <span class="cc-status-indicator"></span>
                                        <%= getStatusLabel(resident.status_aktivitas) %>
                                    </span>

                                </div>

                                <div class="cc-resident-info">

                                    <span class="cc-resident-category">ASSIGNED RESIDENT</span>

                                    <h3><%= resident.nama %></h3>

                                    <div class="cc-resident-age">
                                        <svg viewBox="0 0 24 24">
                                            <circle cx="12" cy="8" r="4"/>
                                            <path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
                                        </svg>

                                        <span>
                                            Usia:
                                            <%= resident.usia !== null && resident.usia !== undefined
                                                ? resident.usia + " tahun"
                                                : "-" %>
                                        </span>
                                    </div>

                                    <div class="cc-resident-divider"></div>

                                    <a
                                        href="/caregiver/resident-detail/<%= resident.id %>"
                                        class="cc-resident-detail-btn"
                                    >
                                        Lihat Detail
                                        <span>→</span>
                                    </a>

                                </div>

                            </article>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="cc-empty-state">

                        <div class="cc-empty-icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="9" cy="8" r="3"/>
                                <path d="M3 20v-1a6 6 0 0 1 12 0v1"/>
                                <path d="M16 5a3 3 0 0 1 0 6"/>
                            </svg>
                        </div>

                        <h3>Belum Ada Data Lansia</h3>

                        <p>
                            Data lansia yang ditugaskan kepada Anda
                            akan ditampilkan di sini setelah admin
                            membuat penugasan.
                        </p>

                    </div>

                <% } %>

            </section>

            <!-- INFORMATION -->
            <div class="cc-notice">
                <div class="cc-notice-icon">i</div>
                <p>
                    Informasi lansia ditampilkan berdasarkan penugasan
                    caregiver yang telah dibuat oleh administrator CareConnect.
                </p>
            </div>

            <footer class="cc-footer">
                <span>CareConnect</span>
                <span>Caregiver Monitoring Platform</span>
            </footer>

        </section>

    </main>

</div>

</body>
</html>
