<%- include('partials/head', { pageTitle: 'Detail caregiver', activeMenu: 'caregivers' }) %>
<%
  const base = typeof adminBasePath !== 'undefined' ? adminBasePath : '/admin';
  const c = caregiver;
  const list = c.residents || [];
%>
<a class="adm-back" href="<%= base %>/caregivers"><%- include('partials/icon', { name: 'arrow-left' }) %> Kembali ke data caregiver</a>
<div class="adm-pagehead">
  <div class="adm-profile">
    <%- include('partials/avatar', { name: c.fullName, tone: 'teal', size: 'lg' }) %>
    <div><h2><%= c.fullName %></h2><p><%= list.length %> lansia ditangani</p></div>
    <% if (c.status === 'active') { %><span class="cc-badge cc-badge--success">Akun aktif</span><% } else { %><span class="cc-badge cc-badge--neutral">Akun nonaktif</span><% } %>
  </div>
  <div class="adm-pagehead__actions">
    <a class="cc-btn cc-btn--primary" href="<%= base %>/caregivers/<%= c.id %>/edit"><%- include('partials/icon', { name: 'edit' }) %> Edit data</a>
    <button type="button" class="cc-btn cc-btn--outline" data-delete-url="<%= base %>/caregivers/<%= c.id %>/delete" data-delete-name="<%= c.fullName %>" data-delete-text="Akun caregiver akan dihapus dan lansia yang ia tangani menjadi belum punya caregiver."><%- include('partials/icon', { name: 'trash' }) %> Hapus</button>
  </div>
</div>
<div class="adm-detail-grid">
  <section class="cc-card">
    <div class="cc-card__head"><h2 class="cc-card__title">Informasi caregiver</h2></div>
    <div class="cc-card__body">
      <dl class="cc-dl">
        <dt>Nama lengkap</dt><dd><%= c.fullName %></dd>
        <dt>Email</dt><dd><%= c.email %></dd>
        <dt>Nomor telepon</dt><dd><%= c.phone %></dd>
        <dt>Alamat</dt><dd><%= c.address %></dd>
        <dt>Status akun</dt><dd><%= c.status === 'active' ? 'Aktif' : 'Nonaktif' %></dd>
      </dl>
    </div>
  </section>
  <section class="cc-card">
    <div class="cc-card__head"><h2 class="cc-card__title">Lansia yang ditangani</h2><a class="cc-btn cc-btn--outline cc-btn--sm" href="<%= base %>/assignments">Atur</a></div>
    <% if (list.length) { %>
    <ul class="adm-queue">
      <% list.forEach(r => { %>
      <li><div class="cc-person"><%- include('partials/avatar', { name: r.fullName }) %><div><a class="cc-person__name" href="<%= base %>/residents/<%= r.id %>"><%= r.fullName %></a><div class="cc-person__sub"><%= r.age %> tahun</div></div></div></li>
      <% }) %>
    </ul>
    <% } else { %>
    <div class="cc-empty"><strong>Belum menangani lansia</strong>Tugaskan lansia lewat halaman penugasan.</div>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
